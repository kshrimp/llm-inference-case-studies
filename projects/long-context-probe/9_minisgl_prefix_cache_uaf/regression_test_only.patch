+"""
+Test that CacheManager.cache_req keeps a still-running request's page table valid when
+another request inserted the same prefix into the radix cache first.
+"""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+import minisgl.core as core
+from minisgl.scheduler.cache import CacheManager
+
+
+@pytest.fixture(autouse=True)
+def reset_global_ctx():
+    """Reset global context before and after each test."""
+    old_ctx = core._GLOBAL_CTX
+    core._GLOBAL_CTX = None
+    yield
+    core._GLOBAL_CTX = old_ctx
+
+
+def _admit(cm: CacheManager, input_ids: torch.Tensor, table_idx: int) -> SimpleNamespace:
+    """Admit and prefill a request: match, lock, allocate its pages, write its page-table row."""
+    handle = cm.match_req(SimpleNamespace(input_len=len(input_ids), input_ids=input_ids)).cuda_handle
+    cm.lock(handle)
+    pages = cm._allocate(len(input_ids) // cm.page_size)
+    cm.page_table[table_idx, : len(input_ids)] = cm._page_to_token(pages)
+    return SimpleNamespace(input_ids=input_ids, cached_len=len(input_ids), table_idx=table_idx,
+                           cache_handle=handle)
+
+
+class TestCacheReqSharedPrefix:
+    def test_running_request_does_not_keep_freed_pages(self):
+        """Two requests with the same prompt prefill together; both stay running after caching."""
+        page_size, num_pages, prompt_len = 4, 8, 8
+        core.set_global_ctx(core.Context(page_size=page_size))
+        page_table = torch.zeros((2, prompt_len), dtype=torch.int32)
+        cm = CacheManager(num_pages, page_size, page_table, type="radix")
+        input_ids = torch.arange(prompt_len, dtype=torch.int32)
+
+        # Both are admitted before either is cached, so neither gets a prefix hit.
+        reqs = [_admit(cm, input_ids, table_idx) for table_idx in range(2)]
+        for req in reqs:
+            cm.cache_req(req, finished=False)  # still running: decode continues
+
+        free_pages = set(cm.free_slots.tolist())
+        for req in reqs:
+            row_pages = set(cm.page_table[req.table_idx, :prompt_len:page_size].tolist())
+            assert not row_pages & free_pages, (
+                f"running request {req.table_idx} references freed pages {row_pages & free_pages}"
+            )
+        # The second request now reads the first request's cached copy of the shared prefix.
+        assert torch.equal(cm.page_table[1, :prompt_len], cm.page_table[0, :prompt_len])
+        # Its duplicate pages were returned, so nothing leaked: 2 pages cached, 6 free.
+        assert len(cm.free_slots) == num_pages - prompt_len // page_size
